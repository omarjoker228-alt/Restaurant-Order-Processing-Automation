    {
      "parameters": {
        "jsCode": "// Contract out: { ok: boolean, kind: 'audio'|'image', text: string, error?: string }\nconst mt = $('Extract Message').first().json.mediaType;\nconst kind = mt === 'audioMessage' ? 'audio' : 'image';\nconst j = $input.first().json ?? {};\nconst text = String(\n  j.content?.parts?.map((p) => p.text ?? '').join('\\n') || j.text || j.output || ''\n).replace(/<think>[\\s\\S]*?<\\/think>/gi, '').trim();\nif (!text) return [{ json: { ok: false, kind, text: '', error: j.error?.message || j.error || 'empty_result' } }];\nreturn [{ json: { ok: true, kind, text } }];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
