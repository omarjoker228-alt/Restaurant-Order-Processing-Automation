    {
      "parameters": {
        "jsCode": "// استخراج موحّد من payload بتاع Evolution API\nconst src = $input.first().json || {};\nconst body = src.body || src;\nconst data = body.data || {};\nconst key = data.key || {};\nconst msg = data.message || {};\nconst ext = msg.extendedTextMessage || {};\n\nconst text = String(\n  msg.conversation ||\n  ext.text ||\n  msg.imageMessage?.caption ||\n  msg.videoMessage?.caption ||\n  msg.documentMessage?.caption ||\n  ''\n).trim();\n\nlet mediaType = '';\nif (msg.audioMessage) mediaType = 'audioMessage';\nelse if (msg.imageMessage) mediaType = 'imageMessage';\nelse if (msg.videoMessage) mediaType = 'videoMessage';\nelse if (msg.documentMessage) mediaType = 'documentMessage';\n\nconst jid = String(key.remoteJid || data.sender || body.sender || '');\nconst phone = jid.split('@')[0].split(':')[0].replace(/\\D/g, '');\n\nreturn [{\n  json: {\n    text: text,\n    number: jid,\n    phone: phone,\n    messageId: key.id || '',\n    mediaType: mediaType,\n    pushName: data.pushName || '',\n  },\n}];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -1856,
        880
      ],
      "id": "4e02200d-5599-45f6-844c-0ceb04d1b2a6",
      "name": "Extract Message",
      "notesInFlow": false,
      "notes": "In: Evolution payload. Out: { text, number (jid), phone (digits), messageId, mediaType, pushName }."
    },
